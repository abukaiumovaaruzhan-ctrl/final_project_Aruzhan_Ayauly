@page "/admin/hotels"

<PageTitle>Manage Hotels</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage Hotels</h1>
    <button class="btn btn-primary">Add New Hotel</button>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Hotel Name</th>
            <th>City</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="5" class="text-center text-muted">No hotels found. Click "Add New Hotel" to start.</td>
        </tr>
    </tbody>
</table>