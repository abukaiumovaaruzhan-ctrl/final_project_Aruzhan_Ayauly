@page "/admin/rooms"

<PageTitle>Manage Rooms</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage Rooms</h1>
    <button class="btn btn-primary">Add New Room</button>
</div>

<div class="mb-4 w-50">
    <label class="form-label fw-bold">Select Hotel:</label>
    <select class="form-select">
        <option>No hotels available...</option>
    </select>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Room Number</th>
            <th>Type</th>
            <th>Capacity (People)</th>
            <th>Price / Night</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="6" class="text-center text-muted">No rooms to display.</td>
        </tr>
    </tbody>
</table>