@page "/admin/reports"

<PageTitle>Reports</PageTitle>

<h1 class="mb-4">Reports & Analytics</h1>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-light fw-bold">
                Hotel Occupancy Report
            </div>
            <div class="card-body">
                <p>Select a date range and download the Excel report.</p>
                <button class="btn btn-outline-success">Download Excel</button>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header bg-light fw-bold">
                Revenue Report
            </div>
            <div class="card-body">
                <p>View revenue charts and download the PDF report.</p>
                <button class="btn btn-outline-success">Download PDF</button>
            </div>
        </div>
    </div>
</div>