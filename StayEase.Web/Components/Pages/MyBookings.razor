
@page "/my-bookings"

<PageTitle>My Bookings | StayEase</PageTitle>

<section class="booking-page">
    <div class="booking-heading">
        <p class="eyebrow">YOUR TRAVEL HISTORY</p>
        <h1>My Bookings</h1>
        <p>Manage your reservations and view your upcoming stays.</p>
    </div>

    <div class="booking-card">
        <div class="booking-hotel">
            <img
                src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=900"
                alt="Grand Palace Hotel" />

            <div>
                <p class="hotel-location">Astana, Kazakhstan</p>
                <h2>Grand Palace Hotel</h2>
                <p>Check-in: November 15, 2026</p>
                <p>Check-out: November 18, 2026</p>
                <strong>$360</strong>
                <p class="booking-status">Demo reservation</p>
            </div>
        </div>
    </div>

    <div class="notice">
        <h2>Ready for another trip?</h2>
        <p>Discover more hotels and find your next destination.</p>
        <a href="/hotels" class="primary-button">
            Explore Hotels
        </a>
    </div>
</section>
