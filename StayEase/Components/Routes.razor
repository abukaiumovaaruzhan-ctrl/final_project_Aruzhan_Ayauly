<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="wrap narrow"><div class="card auth"><h1>Access denied</h1><p class="muted">You don't have permission to view this page.</p><a class="btn" href="">Back to hotels</a></div></div>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="wrap narrow"><div class="card auth"><h1>Page not found</h1><a class="btn" href="">Go home</a></div></div>
        </LayoutView>
    </NotFound>
</Router>
