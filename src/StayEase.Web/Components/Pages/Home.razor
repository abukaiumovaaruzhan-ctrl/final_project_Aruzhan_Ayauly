@page "/"
@inject IDbContextFactory<StayEaseDbContext> DbFactory
<PageTitle>StayEase — Home</PageTitle>
<section class="hero">
    <p class="eyebrow">YOUR NEXT STAY STARTS HERE</p>
    <h1>Find a place to <span>feel at home.</span></h1>
    <p>Discover comfortable hotels and book your next trip with ease.</p>
    <a class="button" href="/hotels">Explore hotels</a>
</section>
<section>
    <div class="section-heading"><div><p class="eyebrow">CURATED FOR YOU</p><h2>Popular stays</h2></div><a href="/hotels">View all →</a></div>
    @if (hotels is null) { <p>Loading hotels…</p> }
    else { <div class="hotel-grid">@foreach (var hotel in hotels) { <HotelCard Hotel="hotel" /> }</div> }
</section>
@code {
    private List<Hotel>? hotels;
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        hotels = await db.Hotels.AsNoTracking().Include(h => h.Rooms).ToListAsync();
    }
}
