@page "/hotel/{Id:int}"
@inject IDbContextFactory<StayEaseDbContext> DbFactory
<PageTitle>Hotel details — StayEase</PageTitle>
@if (hotel is null) { <p>Hotel not found.</p> }
else {
    <a href="/hotels" class="back">← All hotels</a>
    <div class="detail-hero"><p class="eyebrow">STAYEASE COLLECTION</p><h1>@hotel.Name</h1><p>⌖ @hotel.Location · ★ @hotel.Rating.ToString("0.0")</p><p>@hotel.Description</p></div>
    <h2>Available rooms</h2>
    <div class="room-list">
    @foreach (var room in hotel.Rooms.Where(r => r.IsAvailable)) {
        <article class="room-row"><div><h3>@room.Type</h3><p class="muted">Room @room.RoomNumber</p></div><div class="room-price"><strong>@room.PricePerNight.ToString("N0") ₸</strong><a class="button" href="/booking/@room.Id">Book room</a></div></article>
    }
    </div>
}
@code {
    [Parameter] public int Id { get; set; }
    private Hotel? hotel;
    protected override async Task OnParametersSetAsync() {
        await using var db = await DbFactory.CreateDbContextAsync();
        hotel = await db.Hotels.AsNoTracking().Include(h => h.Rooms).FirstOrDefaultAsync(h => h.Id == Id);
    }
}
