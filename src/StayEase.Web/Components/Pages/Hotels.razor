@page "/hotels"
@inject IDbContextFactory<StayEaseDbContext> DbFactory
<PageTitle>Hotels — StayEase</PageTitle>
<p class="eyebrow">DISCOVER YOUR DESTINATION</p><h1>All hotels</h1>
@if (hotels is null) { <p>Loading…</p> }
else if (!hotels.Any()) { <p>No hotels available yet.</p> }
else { <div class="hotel-grid">@foreach (var hotel in hotels) { <HotelCard Hotel="hotel" /> }</div> }
@code {
    private List<Hotel>? hotels;
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        hotels = await db.Hotels.AsNoTracking().Include(h => h.Rooms).ToListAsync();
    }
}
