
@page "/my-bookings"
@using StayEase.Domain.Entities
@inject IDbContextFactory<StayEaseDbContext> DbFactory

<PageTitle>My bookings — StayEase</PageTitle>

<p class="eyebrow">YOUR TRAVEL HISTORY</p>
<h1>My bookings</h1>

@if (bookings is null)
{
    <p>Loading…</p>
}
else if (!bookings.Any())
{
    <div class="empty panel">
        <h2>No bookings yet</h2>
        <p>Your next adventure is waiting.</p>
        <a class="button" href="/hotels">Find a hotel</a>
    </div>
}
else
{
    <div class="panel table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Hotel / room</th>
                    <th>Dates</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in bookings)
                {
                    <tr>
                        <td>
                            <strong>@b.Room?.Hotel?.Name</strong>
                            <br />
                            <span class="muted">
                                @b.Room?.Type · @b.Room?.RoomNumber
                            </span>
                        </td>
                        <td>
                            @b.CheckIn.ToString("dd MMM yyyy") –
                            @b.CheckOut.ToString("dd MMM yyyy")
                        </td>
                        <td>@b.TotalPrice.ToString("N0") ₸</td>
                        <td>
                            <span class="status">@b.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const int DemoCustomerId = 1;

    private List<StayEase.Domain.Entities.Booking>? bookings;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        bookings = await db.Bookings
            .AsNoTracking()
            .Include(b => b.Room)
            .ThenInclude(r => r!.Hotel)
            .Where(b => b.CustomerId == DemoCustomerId)
            .OrderByDescending(b => b.Id)
            .ToListAsync();
    }
}
